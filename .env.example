# ── required. the api refuses to start without these ────────────────────────
OCEANKIND_SESSION_SECRET=change-me-openssl-rand-hex-32
OCEANKIND_STORAGE_BACKEND=local            # local | azure

# ── local backend (development, no cloud account) ───────────────────────────
OCEANKIND_LOCAL_STORAGE_ROOT=/fixtures

# ── azure backend (production) ──────────────────────────────────────────────
# OCEANKIND_STORAGE_BACKEND=azure
# OCEANKIND_AZURE_CONNECTION_STRING=
# OCEANKIND_AZURE_CONTAINER=alerts

# ── s3 backend (later, no code change elsewhere) ────────────────────────────
# OCEANKIND_STORAGE_BACKEND=s3
# OCEANKIND_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── optional ────────────────────────────────────────────────────────────────
OCEANKIND_DB_URL=sqlite:////data/oceankind.db
OCEANKIND_SESSION_HOURS=12
# true in production behind https. false for local http development.
OCEANKIND_COOKIE_SECURE=false
OCEANKIND_BOOTSTRAP_ADMIN_EMAIL=
OCEANKIND_BOOTSTRAP_ADMIN_PASSWORD=
API_PORT=8000

# ── secrets the api holds on behalf of devices. never sent to a browser ─────
# OCEANKIND_TWILIO_SID=
# OCEANKIND_TWILIO_TOKEN=
# signs /api/devices/config (openssl rand -hex 32). without it that route
# answers 503 — loudly — rather than ever serving an unsigned payload.
# the same key goes to each device's /etc/oceankind.env at provisioning.
# OCEANKIND_CONFIG_SIGNING_KEY=

# ── LEGACY-V1 ────────────────────────────────────────────────────────────────
# 1 = read the v1 blob layout and normalize it to v2 on the way in.
# 2 = the real thing. Default. Switching is this one line.
# Remove this whole block after `make drop-v1`.
OCEANKIND_CONTRACT_VERSION=2
# Read the live production container. It is public, so no credential is needed:
#   OCEANKIND_CONTRACT_VERSION=1
#   OCEANKIND_STORAGE_BACKEND=v1_public
OCEANKIND_V1_BASE_URL=https://marfuturatest.blob.core.windows.net/alerts
OCEANKIND_V1_ROOT_SITE=zapallar
OCEANKIND_V1_SITES=zapallar:Zapallar:-32.552665:-71.465068,matanzas:Matanzas:-33.986651:-71.860234
