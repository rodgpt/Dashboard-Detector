# Comments live on their own lines, never after a value.
# `docker run --env-file` keeps everything after the `=` as the value, including
# a trailing comment, which silently turns storage_backend into garbage.

# ── database ────────────────────────────────────────────────────────────────
POSTGRES_USER=oceankind
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=oceankind
OCEANKIND_DB_URL=postgresql+psycopg://oceankind:change-me-in-production@db:5432/oceankind

# ── ports ───────────────────────────────────────────────────────────────────
# The app is on FRONTEND_PORT. BACKEND_PORT is published for debugging only and
# is not exposed in production.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ── required. the api refuses to start without these ────────────────────────
# openssl rand -hex 32
OCEANKIND_SESSION_SECRET=change-me-openssl-rand-hex-32
# local | azure | s3
OCEANKIND_STORAGE_BACKEND=local

# ── local backend (development, no cloud account) ───────────────────────────
OCEANKIND_LOCAL_STORAGE_ROOT=/fixtures

# ── azure backend (production) ──────────────────────────────────────────────
# OCEANKIND_STORAGE_BACKEND=azure
# OCEANKIND_AZURE_CONNECTION_STRING=
# OCEANKIND_AZURE_CONTAINER=alerts

# ── s3 backend (later, no code change elsewhere) ────────────────────────────
# OCEANKIND_STORAGE_BACKEND=s3
# OCEANKIND_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── optional ────────────────────────────────────────────────────────────────
OCEANKIND_SESSION_HOURS=12
# true in production behind https. false for local http development.
# false on a dev machine reached over http; true anywhere behind TLS.
# A Secure cookie is not stored over plain http, so `true` on a laptop breaks
# local login silently — the page loads and the login form does nothing.
OCEANKIND_COOKIE_SECURE=false
# The reconcile pass (R-12.4). 0 disables the in-process timer.
OCEANKIND_RECONCILE_INTERVAL_HOURS=24
OCEANKIND_RECONCILE_WINDOW_DAYS=14

# ── Aviso por equipo sin señal (R-7.5) ──────────────────────────────────────
# ESTE BLOQUE CONTROLA CUÁNTAS NOTIFICACIONES SE ENVÍAN. Nada más en el código
# decide cuándo ni con qué frecuencia se avisa.
#
#   CHECK_INTERVAL  cada cuánto MIRAMOS. Barato (un blob por sitio). No afecta
#                   cuántos avisos se mandan.
#   AFTER_MISSED    cuántos latidos perdidos antes del PRIMER aviso. En latidos
#                   y no en minutos porque heartbeat_interval_s se ajusta a
#                   distancia entre 30 s y 3600 s.
#   MIN_MINUTES     piso, para que un latido rápido no vuelva todo nervioso.
#                   Con estos valores: latido de 60 s avisa a los 20 min.
#   RENOTIFY_HOURS  ANTIINUNDACIÓN. Cada cuánto se REPITE mientras sigue caído.
#                   Un equipo caído una semana manda 7 mensajes, no 2016.
#                   0 = avisar una sola vez por caída y nunca repetir.
OCEANKIND_SILENCE_ALERTS_ENABLED=true
OCEANKIND_SILENCE_CHECK_INTERVAL_MINUTES=5
OCEANKIND_SILENCE_AFTER_MISSED_HEARTBEATS=20
OCEANKIND_SILENCE_MIN_MINUTES=15
OCEANKIND_SILENCE_RENOTIFY_HOURS=24

# ── alertas: el backend es el ÚNICO que envía (Rpi-Detector D-020) ──────────
# Detecciones, silencio, degradación, batería y el "sigo vivo" periódico salen
# de aquí por WhatsApp/llamada con la única credencial Twilio del sistema. Los
# equipos no tienen ninguna credencial Twilio. Sin SID+token+FROM el transporte
# es "log-only": todo queda registrado y visible en el panel, y NADIE recibe
# aviso — /api/health lo dice y el backend lo advierte al arrancar.
OCEANKIND_ALERTS_ENABLED=true
OCEANKIND_TWILIO_SID=
OCEANKIND_TWILIO_TOKEN=
OCEANKIND_TWILIO_FROM=                 # whatsapp:+1415...
OCEANKIND_ALERT_TO=                    # detecciones. coma-separado: whatsapp:+569...,whatsapp:+569...
OCEANKIND_TECH_TO=                     # silencio/degradación/batería/heartbeat. vacío = ALERT_TO
OCEANKIND_CALL_FROM=                   # llamada de voz ante racha de detecciones: +1415...
OCEANKIND_CALL_TO=                     # +569..., coma-separado
OCEANKIND_CALL_CLUSTER_COUNT=3
OCEANKIND_CALL_CLUSTER_WINDOW_S=240
OCEANKIND_CALL_COOLDOWN_S=900
# Plantillas WhatsApp aprobadas (los SID no son secretos). Por defecto, las tres
# que usaba el equipo.
# OCEANKIND_WA_TPL_ALERT=HX...
# OCEANKIND_WA_TPL_HEARTBEAT=HX...
# OCEANKIND_WA_TPL_BATTERY=HX...
OCEANKIND_WA_TPL_VERSION=3
OCEANKIND_DASHBOARD_URL=               # https://... para el enlace ?play= de cada detección
OCEANKIND_ALERT_HEARTBEAT_HOURS=12     # 0 = sin mensaje periódico
OCEANKIND_BATTERY_WARNING_V=11.8
OCEANKIND_BATTERY_CRITICAL_V=11.2
OCEANKIND_BATTERY_EMERGENCY_V=10.8
OCEANKIND_BATTERY_RECOVERY_V=12.2
OCEANKIND_BATTERY_DEBOUNCE_HEARTBEATS=10
OCEANKIND_SITE_TZ=America/Santiago

# ── releases (Rpi-Detector D-021) ───────────────────────────────────────────
# Repositorio cuyos tags git se ofrecen como versiones en Admin → Dispositivos.
OCEANKIND_RELEASE_REPO=rodgpt/Rpi-Detector

# First administrator on a fresh database. Must be a real-format address
# (reserved domains like .local are rejected) and at least 12 characters, or
# the backend refuses to start rather than create an account that cannot log in.
OCEANKIND_BOOTSTRAP_ADMIN_EMAIL=
OCEANKIND_BOOTSTRAP_ADMIN_PASSWORD=

# There is no global device signing key any more (Rpi-Detector D-020): each
# device gets ONE secret at creation in Admin → Dispositivos, and both sides
# derive the auth key and the config-signing key from it. Nothing to set here.
